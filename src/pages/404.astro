---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — PerfectRingSizer"
  description="The page you're looking for doesn't exist."
>
  <section class="section-padding">
    <div class="container-narrow text-center">
      <p class="text-8xl md:text-9xl font-bold text-primary/20 leading-none mb-4">404</p>
      <h1 class="text-3xl md:text-4xl mb-4">Page Not Found</h1>
      <p class="text-lg text-text-secondary mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <a href="/" class="btn-primary mb-12 inline-flex">
        Go to Homepage
      </a>

      <div class="mt-12 pt-8 border-t border-border">
        <p class="text-text-muted mb-6">Or check out these popular pages:</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/ring-size-chart" class="card hover:border-primary hover:shadow-md transition-all group px-6 py-4">
            <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Ring Size Chart</h2>
            <p class="text-sm text-text-muted mt-1">US, UK &amp; EU size charts</p>
          </a>
          <a href="/how-to-measure-ring-size" class="card hover:border-primary hover:shadow-md transition-all group px-6 py-4">
            <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">How to Measure</h2>
            <p class="text-sm text-text-muted mt-1">Find your size at home</p>
          </a>
          <a href="/ring-size-converter" class="card hover:border-primary hover:shadow-md transition-all group px-6 py-4">
            <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Converter</h2>
            <p class="text-sm text-text-muted mt-1">Convert between systems</p>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
