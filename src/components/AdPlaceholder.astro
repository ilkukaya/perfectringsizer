---
interface Props {
  slot?: string;
  className?: string;
}

const { slot = 'in-article', className = '' } = Astro.props;

const isSidebar = slot === 'sidebar';
const minHeight = isSidebar ? 'min-h-[250px]' : 'min-h-[90px]';
---

<div
  class:list={[
    'flex items-center justify-center border border-dashed border-[#E5E5E0] rounded-lg bg-[#FAFAF8]',
    minHeight,
    className,
  ]}
  data-ad-slot={slot}
  aria-hidden="true"
>
  <span class="text-xs text-gray-400 uppercase tracking-wide">Advertisement</span>
</div>

