---
const navLinks = [
  { label: 'Ring Size Chart', href: '/ring-size-chart/' },
  { label: 'How to Measure', href: '/how-to-measure-ring-size-at-home/' },
  { label: 'Converter', href: '/ring-size-converter/' },
  { label: 'Printable Sizer', href: '/printable-ring-sizer/' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-[#1B4D3E] font-bold text-xl hover:opacity-90 transition-opacity">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <circle cx="14" cy="14" r="11" stroke="#D4AF37" stroke-width="2.5" fill="none" />
        <circle cx="14" cy="3" r="2.5" fill="#D4AF37" />
      </svg>
      <span>PerfectRingSizer</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-gray-700 hover:text-[#1B4D3E] transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile Menu Toggle -->
    <label for="mobile-menu-toggle" class="md:hidden cursor-pointer p-2 -mr-2" aria-label="Toggle menu">
      <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </nav>

  <!-- Mobile Menu (CSS-only) -->
  <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" aria-hidden="true" />
  <div class="hidden peer-checked:block md:hidden border-t border-gray-200 bg-white">
    <ul class="px-4 py-3 space-y-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="block py-2 px-3 text-sm font-medium text-gray-700 hover:text-[#1B4D3E] hover:bg-gray-50 rounded-lg transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
