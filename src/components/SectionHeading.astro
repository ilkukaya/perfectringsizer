---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}

const { title, subtitle, id } = Astro.props;
---

<div class="text-center mb-10" id={id}>
  <h2 class="text-2xl sm:text-3xl font-bold text-[#1B4D3E] mb-3">{title}</h2>
  <div class="w-12 h-1 bg-[#D4AF37] rounded-full mx-auto" aria-hidden="true"></div>
  {subtitle && (
    <p class="mt-4 text-gray-600 max-w-2xl mx-auto leading-relaxed">{subtitle}</p>
  )}
</div>
