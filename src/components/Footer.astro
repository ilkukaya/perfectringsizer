---
const quickLinks = [
  { label: 'Ring Size Chart', href: '/ring-size-chart/' },
  { label: 'Size Converter', href: '/ring-size-converter/' },
  { label: 'Printable Sizer', href: '/printable-ring-sizer/' },
  { label: 'How to Measure', href: '/how-to-measure-ring-size/' },
];

const resources = [
  { label: "Men's Sizes", href: '/mens-ring-size/' },
  { label: "Women's Sizes", href: '/womens-ring-size/' },
  { label: 'Oura Ring Guide', href: '/oura-ring-sizing/' },
  { label: 'Brand Guides', href: '/brand-ring-size-guides/' },
];

const about = [
  { label: 'About Us', href: '/about/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms', href: '/terms/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer class="bg-[#1B4D3E] text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <!-- Column Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 md:gap-12">
      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[#D4AF37] mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-300 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[#D4AF37] mb-4">Resources</h3>
        <ul class="space-y-2">
          {resources.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-300 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- About -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[#D4AF37] mb-4">About</h3>
        <ul class="space-y-2">
          {about.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-300 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Affiliate Disclaimer -->
    <div class="mt-10 pt-6 border-t border-white/20">
      <p class="text-xs text-gray-400 leading-relaxed">
        <strong class="text-gray-300">Affiliate Disclosure:</strong> We may earn a commission from qualifying purchases made through links on this site. This does not affect our editorial independence or the accuracy of our sizing information.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-6 pt-6 border-t border-white/20 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-400">
      <p>&copy; 2026 PerfectRingSizer. All rights reserved.</p>
      <p>Based on ISO 8653:2016 standards</p>
    </div>
  </div>
</footer>
